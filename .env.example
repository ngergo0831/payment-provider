# Used by docker-compose.yml. Copy to `.env` (git-ignored) to override; every value has a dev default,
# so `docker compose up -d --build` works with NO .env at all (it then uses the built-in mock payment provider).
# NOTE: the postgres image applies user/password/database only the FIRST time the volume is created.
# Changing them later has no effect until the volume is wiped:  docker compose down -v

POSTGRES_USER=payments
POSTGRES_PASSWORD=payments
POSTGRES_DB=payments

# Host ports (localhost only). Change one if something else on your machine already uses it.
POSTGRES_PORT=5432
BACKEND_PORT=3000
WEB_PORT=8080

# ---- Real Stripe (test mode): uncomment, then run  docker compose --profile stripe up -d --build ----
# PAYMENT_PROVIDER=stripe
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...        # get it with:  docker compose run --rm stripe-cli listen --print-secret
#
# ---- A production-style run additionally needs a real secret (the mock and the example secret are refused) ----
# NODE_ENV=production
# JWT_SECRET=<48+ random characters:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))">
