# Used by docker-compose.yml. Copy to `.env` (git-ignored) to override; every value has a dev default.
# NOTE: the postgres image applies user/password/database only the FIRST time the volume is created.
# Changing them later has no effect until the volume is wiped:  docker compose down -v

POSTGRES_USER=payments
POSTGRES_PASSWORD=payments
POSTGRES_DB=payments

# Host port (localhost only). Change it if another Postgres already uses 5432.
POSTGRES_PORT=5432
