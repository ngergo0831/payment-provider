# Copy to `.env` for local development:   cp .env.example .env
# `.env` holds real values and is git-ignored; this file only documents what exists, with safe placeholders.
# Anything omitted falls back to the default shown here (see src/config/env.validation.ts).

# development | test | production
NODE_ENV=development

# Port the API listens on (1-65535)
PORT=3000
