# Copy to `.env` for local development:   cp .env.example .env
# `.env` holds real values and is git-ignored; this file only documents what exists, with safe placeholders.
# Variables without a default (DATABASE_URL) are REQUIRED: the app refuses to start without them.
# Rules and defaults live in src/config/env.validation.ts.

# development | test | production
NODE_ENV=development

# Port the API listens on (1-65535)
PORT=3000

# PostgreSQL connection string (postgres:// or postgresql://). It contains the password: never commit or log it.
# This value matches the defaults of ../docker-compose.yml (start it with `docker compose up -d`).
DATABASE_URL=postgres://payments:payments@localhost:5432/payments

# Secret used to sign access tokens (HS256). REQUIRED, at least 32 characters. The value below is for local
# development ONLY. Generate a real one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=dev-only-secret-change-me-it-must-be-32+chars

# How long a token stays valid: a number and a unit (s, m, h, d). Default 24h (long on purpose: no refresh tokens).
JWT_EXPIRES_IN=24h
