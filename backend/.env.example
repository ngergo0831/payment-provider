# Copy to `.env` for local development:   cp .env.example .env
# `.env` holds real values and is git-ignored; this file only documents what exists, with safe placeholders.
# Variables without a default (NODE_ENV, DATABASE_URL, JWT_SECRET, PAYMENT_PROVIDER) are REQUIRED: the app refuses to
# start without them.
# Rules and defaults live in src/config/env.validation.ts.

# development | test | production. REQUIRED. Production refuses the mock provider and does not serve Swagger.
NODE_ENV=development

# Port the API listens on (1-65535)
PORT=3000

# PostgreSQL connection string (postgres:// or postgresql://). It contains the password: never commit or log it.
# This value matches the defaults of ../docker-compose.yml (start it with `docker compose up -d`).
DATABASE_URL=postgres://payments:payments@localhost:5432/payments

# Secret used to sign access tokens (HS256). REQUIRED, at least 32 characters. The value below is for local
# development ONLY. Generate a real one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=dev-only-secret-change-me-it-must-be-32+chars

# How long a token stays valid: a number and a unit (s, m, h, d). Default 24h (long on purpose: no refresh tokens).
JWT_EXPIRES_IN=24h

# The one plan on sale, in MINOR units: 4900 USD = 49.00 dollars, but 4900 JPY = 4900 yen.
# The currency must be one the Money type supports (USD, EUR, GBP, JPY, ...); anything else stops the app at startup.
PLAN_PRICE_MINOR=4900
PLAN_CURRENCY=USD

# How often queued messages (e.g. "payment succeeded" -> activate the company) are delivered, in milliseconds.
# 0 turns the timer off. Delivery is retried with growing delays if it fails.
OUTBOX_POLL_INTERVAL_MS=1000

# How often payments that went quiet are compared with the payment provider, in milliseconds (default 60000).
# This is the safety net for a lost or very late webhook. 0 turns the timer off.
RECONCILE_INTERVAL_MS=60000

# How much to log: error | warn | log (default: what happened, e.g. payment state changes) | debug (also routine
# reads such as the activation polling, and how long each payment-provider call took).
LOG_LEVEL=log

# text (default, readable in a terminal) | json (one object per line, for CloudWatch, Datadog, ELK...).
# Secrets (API keys, tokens, payment client secrets) are removed from every log line in either format.
LOG_FORMAT=text

# Requests per minute per client IP on POST /auth/register and POST /payments (default 20). Further calls get 429.
RATE_LIMIT_PER_MINUTE=20

# Which payment provider to use. REQUIRED:
#   mock   = built in, no account or keys needed (development and tests ONLY; refused when NODE_ENV=production).
#            Also enables the /dev/mock-payments endpoints that simulate the customer and the provider.
#   stripe = real Stripe; needs the three settings below
PAYMENT_PROVIDER=mock

# Only needed when PAYMENT_PROVIDER=stripe. Get them from the Stripe dashboard (use TEST mode keys while developing).
# The secret key and the webhook secret are secrets: never commit them, never log them.
#   STRIPE_SECRET_KEY=sk_test_...
#   STRIPE_PUBLISHABLE_KEY=pk_test_...       (safe to expose to the browser; served by GET /checkout-config)
#   STRIPE_WEBHOOK_SECRET=whsec_...          (the signing secret of the webhook endpoint pointing at POST /webhooks/payments)
